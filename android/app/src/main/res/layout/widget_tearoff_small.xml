<?xml version="1.0" encoding="utf-8"?>
<!-- Tear-off widget, 2x2: the binding, the month, today's big date and the day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/paper_grain" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@drawable/widget_binding">
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="26dp" android:importantForAccessibility="no" android:src="@drawable/widget_hole" />
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="26dp" android:importantForAccessibility="no" android:src="@drawable/widget_hole" />
        </FrameLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="5dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_torn" />

        <TextView
            android:id="@+id/w_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:letterSpacing="0.04"
            android:textColor="#28251E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/dm_serif_display"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.06"
            android:textColor="#BF292A"
            android:textSize="60sp" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeMaxTextSize="96sp" />

        <TextView
            android:id="@+id/w_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="serif"
            android:letterSpacing="0.16"
            android:textColor="#BF292A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
